{
    "$schema": "http://json-schema.org/schema",
    "id": "https://boschrexroth/kvd/schema/nodes.v1.0.schema.json",
    "description": "Schema for KVD nodes configuration.",
    "type": "object",
    "properties": {
        "description": {
            "type": "string"
        },
        "types": {
            "type": "array",
            "items": {
                "$ref": "./type.v1.0.schema.json"
            }
        },
        "nodes": {
            "type": "array",
            "items": {
                "$ref": "./node.v1.0.schema.json"
            }
        }
    },
    "required": [
        "types",
        "nodes"
    ]
}
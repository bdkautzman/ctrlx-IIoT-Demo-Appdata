{
    "boschrexroth": {
        "editor": {
            "view": {
                "view-store-zoom": false,
                "view-store-position": false,
                "view-show-grid": true,
                "view-snap-grid": true,
                "view-grid-size": "20",
                "view-node-status": true,
                "view-node-show-label": true,
                "view-show-tips": true,
                "view-show-welcome-tours": true,
                "view-node-info-icon": true
            },
            "tours": {
                "welcome": "4.0.9-ctrlx"
            },
            "dialog": {
                "export": {
                    "pretty": true,
                    "json-view": true
                }
            }
        },
        "nrlint": {
            "rules": {
                "align-to-grid": true,
                "function-eslint": true,
                "max-flow-size": true,
                "no-duplicate-http-in-urls": true,
                "no-loops": {
                    "followLinkNodes": false
                },
                "no-overlapping-nodes": true,
                "no-unconnected-http-nodes": true,
                "no-unnamed-functions": {
                    "allowDefaultNames": true
                },
                "no-unnamed-links": {
                    "allowDefaultNames": true
                }
            },
            "auto": true,
            "lintDisabledFlows": true
        },
        "menu-menu-item-sidebar": true
    }
}
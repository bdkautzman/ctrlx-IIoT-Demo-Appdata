        "func": "// Storing in \"saved_headers\" so it persists through HTTP nodes for use in other requests\nmsg.saved_headers = {\n    \"Authorization\" : \"Bearer \" + msg.payload.access_token\n}\n\nmsg.headers = msg.saved_headers;\nreturn msg;",

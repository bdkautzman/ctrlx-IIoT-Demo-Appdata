    {
        "id": "490b889ea2d61e67",
        "type": "comment",
        "z": "e205697bfa7bcb30",
        "name": "READ ME",
        "info": "This flow demos sending emails with different content via a Gmail SMTP server. The flow\nalso interfaces with the Security Scanner App API to generate a security report PDF\nthat is sent in an email.\n\nExamples use palette 'node-red-node-email' for email node, '@platmac/node-red-pdfbuilder' \nfor PDF generation and 'node-red-contrib-zip' for file decompression",
        "x": 100,
        "y": 40,
        "wires": []
    },

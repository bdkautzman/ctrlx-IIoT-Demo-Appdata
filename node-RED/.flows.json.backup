    {
        "id": "ddb62c736ad3fdc8",
        "type": "function",
        "z": "9b9592b1ea29f4d8",
        "name": "Format Query",
        "func": "let name = global.get('entryName');\nlet age = global.get('entryAge');\nlet profession = global.get('entryProfession');\n\nmsg.payload = {\n    \"type\": \"string\",\n    \"value\": \"insert into customers VALUES ('\" + name + \"', '\" + age + \"','\" + profession + \"')\"\n}\nreturn msg;",
        "outputs": 1,

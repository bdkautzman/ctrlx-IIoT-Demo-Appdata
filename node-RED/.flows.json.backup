    {
        "id": "9c32f86ca217dc01",
        "type": "function",
        "z": "e205697bfa7bcb30",
        "name": "Build Report",
        "func": "msg.payload = {\n  \"content\": [\n    {\n      \"image\": \"data:image/png;base64,\",\n      \"width\": 150,\n      \"alignment\": \"center\",\n      \"margin\": [0, 0, 0, 20]\n    },\n    {\n      \"text\": \"ctrlX Core Metrics (Actual Data)\",\n      \"style\": \"header\"\n    },\n    {\n      columns: [\n        { width: '*', text: '' },\n        {\n          width: \"auto\",\n          \"layout\": \"lightHorizontalLines\",\n          \"alignment\": \"center\",\n          \"table\": {\n            \"alignment\": \"center\",\n            \"headerRows\": 1,\n            \"widths\": [165, 75, 50],\n            \"body\": [\n              [{ text: \"Metric\", alignment: \"left\" }, \"Value\", \"Unit\"],\n              [{ text: \"Core Temperature (24h avg.)\", alignment: \"left\" }, Math.round(10 * msg.payload.core_temp_avg_24h) / 10, \"deg C\"],\n              [{ text: \"Core Temperature (1h avg.)\", alignment: \"left\" }, Math.round(10 * msg.payload.core_temp_avg_1h) / 10, \"deg C\"],\n              [{ text: \"CPU Usage (24h avg.)\", alignment: \"left\" }, Math.round(10 * msg.payload.cpu_avg_24h) / 10, \"%\"],\n              [{ text: \"CPU Usage (1h avg.)\", alignment: \"left\" }, Math.round(10 * msg.payload.cpu_avg_1h) / 10, \"%\"],\n              [{ text: \"Operating Hours\", alignment: \"left\" }, Math.round(10 * msg.payload.core_op_hours) / 10, \"h\"],\n            ]\n          }\n        },\n        { width: '*', text: '' },\n      ]\n    },\n    {\n      \"text\": \"Production Report Example (Sample Data)\",\n      \"style\": \"header\",\n      \"margin\": [0, 75, 0, 0]\n    },\n    {\n      \"text\": \"Daily Production Summary with Operator Performance\",\n      \"style\": \"subheader\",\n      \"alignment\": \"center\",\n      \"margin\": [0, 10, 0, 20]\n    },\n    {\n      \"layout\": \"lightHorizontalLines\",\n      \"table\": {\n        \"headerRows\": 1,\n        \"widths\": [\"auto\", \"auto\", \"*\", \"auto\", \"auto\", \"*\"],\n        \"body\": [\n          [\"Date\", \"Shift\", \"Product\", \"Units Produced\", \"Defective Units\", \"Operator\"],\n          [\"2025-01-01\", \"Morning\", \"Product A\", \"1000\", \"20\", \"John Doe\"],\n          [\"2025-01-01\", \"Afternoon\", \"Product B\", \"950\", \"15\", \"Jane Smith\"],\n          [\"2025-01-02\", \"Morning\", \"Product A\", \"1050\", \"10\", \"James Brown\"],\n          [\"2025-01-02\", \"Afternoon\", \"Product C\", \"800\", \"30\", \"Emily Clark\"],\n          [\"2025-01-03\", \"Morning\", \"Product B\", \"1100\", \"25\", \"Michael Green\"],\n          [\"2025-01-03\", \"Afternoon\", \"Product A\", \"980\", \"18\", \"Sarah White\"]\n        ]\n      }\n    },\n    {\n      \"text\": \"This table summarizes the daily production output across different shifts and operators. It includes total units produced and defective units recorded for quality analysis.\",\n      \"fontSize\": 12,\n      \"alignment\": \"justify\",\n      \"margin\": [0, 10, 0, 20]\n    },\n    {\n      \"text\": \"Internal Use Only - Bosch Rexroth\",\n      \"style\": \"footer\",\n      \"alignment\": \"center\",\n      \"margin\": [0, 20, 0, 0]\n    }\n  ],\n  \"styles\": {\n    \"header\": {\n      \"fontSize\": 20,\n      \"bold\": true,\n      \"alignment\": \"center\",\n      \"margin\": [0, 20, 0, 10]\n    },\n    \"subheader\": {\n      \"fontSize\": 14,\n      \"italics\": true,\n      \"color\": \"grey\",\n      \"margin\": [0, 10, 0, 20]\n    },\n    \"footer\": {\n      \"fontSize\": 10,\n      \"color\": \"grey\"\n    }\n  },\n  \"pageSize\": \"A4\",\n  \"pageMargins\": [40, 60, 40, 60]\n}\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 870,
        "y": 580,
        "wires": [
            [
                "56ea04acd88b780b"
            ]
        ]
    },

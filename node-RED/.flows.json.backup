    {
        "id": "cb46534051f35189",
        "type": "function",
        "z": "e205697bfa7bcb30",
        "name": "Format Query Response",
        "func": "let newMsg = {\n    payload : {\n        core_temp_avg_24h : 0,\n        core_temp_avg_1h : 0,\n        cpu_avg_24h : 0,\n        cpu_avg_1h : 0,\n        core_op_hours : 0,\n    }\n}\nmsg.payload.forEach(function(el) {\n    if(el.result == \"core_temp_avg_24h\"){\n        newMsg.payload.core_temp_avg_24h = el._value;\n    } else if (el.result == \"core_temp_avg_1h\") {\n        newMsg.payload.core_temp_avg_1h = el._value;\n    } else if (el.result == \"cpu_avg_24h\") {\n        newMsg.payload.cpu_avg_24h = el._value;\n    } else if (el.result == \"cpu_avg_1h\") {\n        newMsg.payload.cpu_avg_1h = el._value;\n    } else if (el.result == \"core_op_hours\") {\n        newMsg.payload.core_op_hours = el._value;\n    }\n});\nmsg = newMsg;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 580,
        "wires": [
            [
                "9c32f86ca217dc01"
            ]
        ]
    },
    {
        "id": "56ea04acd88b780b",
        "type": "pdfbuilder",
        "z": "e205697bfa7bcb30",
        "name": "",
        "outputType": "Buffer",
        "inputProperty": "payload",
        "options": "{}",
        "outputProperty": "payload",
        "x": 1040,
        "y": 580,
        "wires": [
            [
                "d597a7f95d8b96c1"
            ]
        ]
    },
    {
        "id": "5c9b8f3bac6d7726",
        "type": "influxdb in",
        "z": "e205697bfa7bcb30",
        "influxdb": "790e860c35c1d63b",
        "name": "Query Core Metrics",
        "query": "cpu_avg_24h = from(bucket: \"core metrics\")\n  |> range(start: -1d, stop: now())\n  |> filter(fn: (r) => r[\"_measurement\"] == \"metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"cpu_usage_percent\")\n  |> mean()\n  |> yield(name: \"cpu_avg_24h\")\n\ncpu_avg_1h = from(bucket: \"core metrics\")\n  |> range(start: -1h, stop: now())\n  |> filter(fn: (r) => r[\"_measurement\"] == \"metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"cpu_usage_percent\")\n  |> mean()\n  |> yield(name: \"cpu_avg_1h\")\n\ncore_temp_avg_24h = from(bucket: \"core metrics\")\n  |> range(start: -1d, stop: now())\n  |> filter(fn: (r) => r[\"_measurement\"] == \"metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"core_temp\")\n  |> mean()\n  |> yield(name: \"core_temp_avg_24h\")\n\ncore_temp_avg_1h = from(bucket: \"core metrics\")\n  |> range(start: -1h, stop: now())\n  |> filter(fn: (r) => r[\"_measurement\"] == \"metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"core_temp\")\n  |> mean()\n  |> yield(name: \"core_temp_avg_1h\")\n\ncore_op_hours = from(bucket: \"core metrics\")\n  |> range(start: -30m, stop: now())\n  |> filter(fn: (r) => r[\"_measurement\"] == \"metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"op_hours\")\n  |> last()\n  |> yield(name: \"core_op_hours\")",
        "rawOutput": false,
        "precision": "",
        "retentionPolicy": "",
        "org": "boschrexroth",
        "x": 430,
        "y": 580,
        "wires": [
            [
                "cb46534051f35189"
            ]
        ]
    },

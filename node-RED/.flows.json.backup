    {
        "id": "df5ffd203753efcb",
        "type": "comment",
        "z": "6d1d0a407ad4f998",
        "name": "READ ME",
        "info": "This flow demos sending emails with different content via a Gmail SMTP server. The flow\nalso interfaces with the Security Scanner App API to generate a security report PDF\nthat is sent in an email. The KVD app is used to generate nodes on the datalayer which\nact as an intermediary between WebIQ and Node-RED\n\nExamples use palette 'node-red-node-email' for email node, '@platmac/node-red-pdfbuilder' \nfor PDF generation and 'node-red-contrib-zip' for file decompression",
        "x": 100,
        "y": 40,
        "wires": []
    },

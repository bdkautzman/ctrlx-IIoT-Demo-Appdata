{
"$schema": "https://json-schema.org/draft/2019-09/schema",
"definitions": {
"motion_drivecmd_fbtypes_DiffType" : {
"type" : "string",
"enum": ["UNDEFINE", "DIFF_DISABLED", "DIFF_STANDARD_MODE", "DIFF_NEG_TO_NEG_EDGE", "DIFF_POS_TO_NEG_EDGE", "DIFF_NEG_TO_POS_EDGE", "DIFF_POS_TO_POS_EDGE"]
},
"motion_drivecmd_fbtypes_InterpType" : {
"type" : "string",
"enum": ["UNDEFINE", "LINEAR"]
},
"motion_drivecmd_fbtypes_ShotType" : {
"type" : "string",
"enum": ["UNDEFINE", "CONTINUOUS", "SINGLE_SHOT"]
},
"motion_drivecmd_fbtypes_SignalSelect" : {
"type" : "string",
"enum": ["UNDEFINE", "ENCODER_1", "ENCODER_2", "FINE_TIME", "IPO_POS", "ACT_POS", "MOTION_INTERNAL_DATA"]
},
"motion_drivecmd_fbtypes_AxsCfgProbeData" : {
"type" : "object",
"description" : "parameters of single probe data",
"properties" : {
"signal" : {
"$ref" : "#/definitions/motion_drivecmd_fbtypes_AxsCfgProbeSignalData",
"description" : "probe signal config"
},
"edge" : {
"$ref" : "#/definitions/motion_drivecmd_fbtypes_AxsCfgProbeEdgeData",
"description" : "edge config"
},
"mkrFail" : {
"$ref" : "#/definitions/motion_drivecmd_fbtypes_AxsCfgProbeMarkerFailureData",
"description" : "marker failure config"
},
"expWin" : {
"$ref" : "#/definitions/motion_drivecmd_fbtypes_AxsCfgProbeExpectWindowData",
"description" : "expect window data"
},
"deadTime" : {
"$ref" : "#/definitions/motion_drivecmd_fbtypes_AxsCfgProbeDeadTimeData",
